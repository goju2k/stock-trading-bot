# .env.local 템플릿. 이 파일을 복사해서 워크스페이스 루트에 .env.local로 저장하고
# 실제 값을 채워넣을 것 (.env.local은 .gitignore에 있어서 git에 올라가지 않는다).
#
#   cp .env.example .env.local
#
# 이 파일 하나를 Vite 프론트엔드(apps/stock-trading-bot)와 trading-server가 같이 읽는다.

# ================================================================
# apps/stock-trading-bot (레거시 FE) - 브라우저에서 KIS를 직접 호출할 때 사용
# ================================================================

# apps/kis-server 프록시 주소 + /api-proxy 경로. 로컬에서 kis-server를 직접 띄웠다면
# http://localhost:3000/api-proxy, 배포된 프록시를 쓴다면 그 서버 주소.
VITE_KIS_HOST=http://localhost:3000/api-proxy

# KIS 개발자센터(https://apiportal.koreainvestment.com)에서 발급받은 실전투자 앱키/시크릿.
VITE_KIS_APP_KEY=
VITE_KIS_APP_SECRET=

# 종합계좌번호 8자리 (계좌번호 체계 8-2 중 앞 8자리).
VITE_KIS_CANO=

# 선택. 비워두면 앱이 런타임에 oauth2/tokenP로 직접 발급받아 localStorage에 캐싱한다.
# 미리 발급받은 토큰을 강제로 쓰고 싶을 때만 채운다.
VITE_KIS_TOKEN=

# ================================================================
# apps/trading-server - 서버 상시구동 자동매매
# ================================================================

# Postgres 연결 문자열. 형식: postgresql://<user>:<password>@<host>:<port>/<dbname>
# 비밀번호에 '@'가 포함돼 있으면 URL 인코딩(%40) 없이도 대체로 파싱은 되지만, 문제가
# 생기면 %40으로 인코딩할 것.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# paper(모의투자) | real(실전투자). 기본값은 paper - 안전을 위해 real은 명시적으로만 켠다.
KIS_ENV=paper

# 실전투자 계좌. host는 KIS 고정 실전 엔드포인트라 안 바뀐다. appkey/secret/CANO는
# 개발자센터에서 실전투자용으로 발급받은 값 (VITE_KIS_APP_KEY와 같은 계좌를 써도 됨).
# 개장일 조회(chk-holiday) TR이 모의투자에서 지원 안 돼서 이 값들은 KIS_ENV=paper여도 필수다.
KIS_REAL_HOST=https://openapi.koreainvestment.com:9443
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_CANO=

# 모의투자 계좌. host는 KIS 고정 모의투자 엔드포인트. appkey/secret/CANO는 개발자센터에서
# "모의투자 신청" 후 별도로 발급받아야 한다 (실전투자 앱키와 다른 값).
KIS_PAPER_HOST=https://openapivts.koreainvestment.com:29443
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_CANO=

# trading-server가 바인딩할 host/port. 로컬 개발 기본값.
HOST=localhost
PORT=3001

# 제어용 FE가 REST API 호출 시 x-api-key 헤더로 보내는 값. 실거래를 제어하는 API라
# 이 값이 없으면 서버가 모든 /api 요청을 401/500으로 막는다(fail-closed).
# 아래 명령으로 랜덤 값 하나 생성해서 채우면 된다:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=

# ================================================================
# apps/trading-control - trading-server 제어용 웹앱 (안드로이드 웹뷰로 로드될 화면)
# ================================================================

# trading-server 주소. 로컬 개발시 위 HOST/PORT 그대로.
VITE_TRADING_SERVER_HOST=http://localhost:3001

# 위 API_TOKEN과 동일한 값. trading-server가 x-api-key로 검증하는 값이라 반드시 일치해야 한다.
VITE_TRADING_SERVER_API_TOKEN=
