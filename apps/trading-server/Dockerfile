# This file is generated by Nx.
#
# Build the docker image with `npx nx docker-build trading-server`.
# Tip: Modify "docker-build" options in project.json to change docker build args.
#
# Run the container with `docker run -p 3001:3001 -t trading-server`.
FROM docker.io/node:lts-alpine

ENV HOST=0.0.0.0
ENV PORT=3001

WORKDIR /app

RUN addgroup --system trading-server && \
          adduser --system -G trading-server trading-server

COPY dist/apps/trading-server trading-server
RUN chown -R trading-server:trading-server .

# You can remove this install step if you build with `--bundle` option.
# The bundled output will include external dependencies.
RUN npm --prefix trading-server --omit=dev -f install

# prisma/schema.prisma is copied in via project.json's build "assets". Regenerate the client
# against it here since @prisma/client's own postinstall can't find a schema outside the app dir.
RUN npx --prefix trading-server --yes prisma generate --schema=trading-server/prisma/schema.prisma

CMD [ "node", "trading-server" ]
