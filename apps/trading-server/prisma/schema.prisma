generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KisEnv {
  paper
  real
}

enum PositionState {
  checking
  watching_for_sell
  sell_waiting
  done
  error
}

enum TradeEventType {
  session_start
  session_end
  buy_executed
  buy_failed
  sell_executed
  sell_failed
  forced_liquidation
  error
}

// 하루 1행. 서버가 실제로 참조하는 매매 파라미터 (AdvanceOrder 화면에서 편집).
model TradingConfig {
  id                 Int      @id @default(1)
  refreshRateMs      Int      @default(1000)
  highPercentage     Float    @default(3)
  lowPercentage      Float    @default(4)
  maxOrderAmt        Int      @default(30000)
  minTargetAmt       Int      @default(4000)
  minTradingCount    Int      @default(1000000)
  targetUpRating     Float    @default(15)
  targetIncreaseRate Float    @default(100)
  kisEnv             KisEnv   @default(paper)
  autoTradingEnabled Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  @@map("trading_config")
}

// 영업일 기준 하루 1행. cron이 09:00에 열고 15:25 청산 트리거, 16:00에 닫는다.
model TradingSession {
  id            Int       @id @default(autoincrement())
  sessionDate   DateTime  @unique @db.Date
  isBusinessDay Boolean
  kisEnv        KisEnv
  openedAt      DateTime?
  liquidationAt DateTime?
  closedAt      DateTime?

  orders Order[]
  events TradeEvent[]

  @@map("trading_sessions")
}

// 당일 매수 체결 1건 = 기존 OrderStocks/OrderListStore 항목에 대응.
model Order {
  id        Int      @id @default(autoincrement())
  sessionId Int
  code      String
  name      String?
  buyPrice  Decimal  @db.Decimal(12, 2)
  qty       Int
  kisOrderNo String?
  orderedAt DateTime @default(now())

  session         TradingSession   @relation(fields: [sessionId], references: [id])
  positionWatcher PositionWatcher?

  @@index([sessionId, code])
  @@map("orders")
}

// 매수 1건당 상태머신 1행 = 기존 TradingStrategy/SellByPercent 인스턴스에 대응.
model PositionWatcher {
  id           Int           @id @default(autoincrement())
  orderId      Int           @unique
  code         String
  state        PositionState @default(checking)
  sellAmtHigh  Decimal?      @db.Decimal(12, 2)
  sellAmtLow   Decimal?      @db.Decimal(12, 2)
  highOrLow    String?
  stateMessage String?
  updatedAt    DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("position_watchers")
}

// 로그센터 대체 + FCM 푸시 트리거용 append-only 이벤트.
model TradeEvent {
  id        Int             @id @default(autoincrement())
  sessionId Int?
  type      TradeEventType
  code      String?
  message   String
  payload   Json?
  createdAt DateTime        @default(now())

  session TradingSession? @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("trade_events")
}

// 안드로이드 웹뷰 앱이 등록한 FCM 디바이스 토큰.
model DeviceToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("device_tokens")
}

// env(모의/실전)별 KIS access token 캐시. 재시작해도 재발급받지 않도록 영속화.
model KisToken {
  env         KisEnv   @id
  accessToken String
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@map("kis_tokens")
}
